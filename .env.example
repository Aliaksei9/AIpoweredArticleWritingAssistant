POSTGRES_DB=coursework
POSTGRES_USER=coursework
POSTGRES_PASSWORD=coursework
POSTGRES_PORT=5433
DATABASE_URL=postgresql://coursework:coursework@localhost:5433/coursework
TG_API_ID=
TG_API_HASH=
TG_SESSION=.telegram_session
# Keep downloaded model files inside the project:
HF_HOME=.cache/huggingface
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
# Prefix labels without ': '; leave empty for models that do not require them.
EMBEDDING_DOCUMENT_PREFIX=passage
EMBEDDING_QUERY_PREFIX=query
# Text correction through OpenRouter:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_FREE_ONLY=true
OPENROUTER_MAX_INPUT_TOKENS=24000
OPENROUTER_MAX_OUTPUT_TOKENS=8192
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_RETRIES=2
OPENROUTER_REASONING_ENABLED=false
OPENROUTER_FALLBACK_MODELS=dots-studio/dots-3-note-preview:free,google/gemma-4-26b-a4b-it:free
TEXT_CORRECTION_MAX_EXAMPLES=8
TEXT_CORRECTION_MIN_SCORE=5
TEXT_CORRECTION_MIN_SIMILARITY=0.6
# Local editor: python -m src.ui
UI_PORT=8000
UI_MAX_EXAMPLES=5
